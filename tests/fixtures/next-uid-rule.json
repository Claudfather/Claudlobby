    {"case": "cr-after-later-fields", "passwd": [["root:x:0:0:root:/root:/bin/bash\na:x:1500:1500::/:/bin/sh\r\n", 1]], "group": [["root:x:0:\ng:x:1600:\r\n", 1]], "logins_null": false, "next_uid": 1601},
