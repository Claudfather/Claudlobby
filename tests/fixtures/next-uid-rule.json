    {"case": "highest-59998", "passwd": [["root:x:0:0:root:/root:/bin/bash\na:x:59998:59998::/:/bin/sh\n", 1]], "group": [["root:x:0:\n", 1]], "logins_null": false, "next_uid": 59999},
    {"case": "highest-59999-is-null", "passwd": [["root:x:0:0:root:/root:/bin/bash\na:x:59999:1::/:/bin/sh\n", 1]], "group": [["root:x:0:\n", 1]], "logins_null": false, "next_uid": null},
    {"case": "group-59999-is-null", "passwd": [["root:x:0:0:root:/root:/bin/bash\n", 1]], "group": [["root:x:0:\ng:x:59999:\n", 1]], "logins_null": false, "next_uid": null},
    {"case": "60000-is-ignored", "passwd": [["root:x:0:0:root:/root:/bin/bash\na:x:60000:60000::/:/bin/sh\nb:x:1500:1500::/:/bin/sh\n", 1]], "group": [["root:x:0:\n", 1]], "logins_null": false, "next_uid": 1501},
