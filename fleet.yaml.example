# Example fleet.yaml — copy to fleet.yaml and customize.
# See documentation/fleet-yaml-schema.md for the full reference.
#
# The three config tiers: system.yaml (HOW the platform runs) → this file
# (WHO the bots are, what the fleet serves) → projects.yaml (WHAT the work
# is and what "done" requires per project — see projects.yaml.example).

# ---------------------------------------------------------------------------
# YAML Anchors — define reusable blocks above `fleet:`, reference with *anchor.
# Use <<: *anchor to merge an anchor into a bot stanza (bot keys override).
# ---------------------------------------------------------------------------
#
# x-all-repos: &all-repos                       # shared repo list
#   - repo-a
#   - repo-b
#   - repo-c
#
# x-engineer-base: &engineer-base               # shared engineer config
#   integrations: [neon, railway, vercel]
#   principles: [visibility-and-speed]
#   protocols: [implementer-workflow]
#   scope:
#     org: my-github-org
#     repos: *all-repos
#
# Then in a bot stanza:
#   eng-1:
#     <<: *engineer-base                         # merges all keys from anchor
#     expertise: [software-engineering]           # bot-specific keys override
#     voice: voices/dinesh.md

fleet:
  name: example-fleet
  service_prefix: com.example.claudlobby
  telegram_group_chat_id: "-1001234567890"   # replace with your group ID
  # human_telegram_id: "1234567890"          # your Telegram user ID — enables DM allowlisting for all bots

  # Fleet mission — one paragraph composed into EVERY bot as its goal anchor;
  # mission_file: adds a fuller charter (managers compose it; workers get a
  # pointer) and REQUIRES mission. See documentation/fleet-yaml-schema.md.
  # mission: This fleet exists to make the operator's ventures succeed — grow acme-shop revenue, ship post-scheduler reliably.
  # mission_file: missions/fleet.md

  accounts:
    default: ~/.claude
    # work: ~/.claude-work                    # uncomment if you have a 2nd Claude account

  # plugins:                            # OPTIONAL — claudna@Claudfather is installed by default
  #   additional:                       # Extra plugins beyond the defaults
  #     - telegram@claude-plugins-official
  #   # include_defaults: false         # Uncomment to disable built-in defaults (unusual)
  #   # marketplaces:                   # Third-party marketplaces (Claudfather is pre-registered)
  #   #   MyMarket:
  #   #     source: { source: github, repo: MyOrg/my-plugins }

  defaults:
    model: opus
    effort: max
    account: default
    prompt_suggestions: false                # disable autocomplete suggestions (headless bots don't need them)
    # Headless config defaults (all overridable per bot):
    disable_nonessential_traffic: true       # CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 — kills the survey, transcript-consent, telemetry, auto-updater (claudlobby manages CC updates)
    spinner_tips_enabled: false              # settings.local spinnerTipsEnabled — silence the "Tip:" lines
    preferred_notif_channel: notifications_disabled  # settings.local preferredNotifChannel — no desktop on a headless bot
    prefers_reduced_motion: true             # settings.local prefersReducedMotion — safe now that keepalive liveness is marker-based
    mcp: [github]                             # MCP servers all bots use (bot stanza merges, not replaces)
    guardrails: [no-push-main, no-destructive-git, pii-protection, no-fabrication, no-merge-own-pr]
    # worker-lifecycle is the ack/report doctrine's canonical owner — several
    # default protocols cite its Step 2, and it self-scopes (fires only on
    # id'd task dispatches), so managers carry it harmlessly and cross-fleet
    # dispatch recipients (measured: 44.6% of traffic) need it.
    protocols: [report-back, worker-lifecycle, context-management, telegram-routing, telegram-formatting]
    # git_credentials:                         # OPTIONAL — org -> env var NAME (never a token)
    #   MyOrg: MYORG_GITHUB_PAT                # needed when bots push to >1 org: fine-grained
    #   OtherOrg: OTHERORG_GITHUB_PAT          # PATs are single-owner, so one token can't do both.
    #                                          # Composes <bot_dir>/.gitconfig + GIT_CONFIG_GLOBAL.
    # github_app:                              # OPTIONAL — GitHub App git auth (App-auth P3 #1273).
    #   slug: my-fleet-app                     # BOTH slug + bot_user_id -> commits as <slug>[bot];
    #   bot_user_id: 1234567                   # omit both to keep the operator identity. Values from
    #   # orgs: [MyOrg]                        # lib/setup-github-app.sh. orgs: scopes the App helper
    #                                          # (else all of github.com). Restart-not-reload applies.
    #                                          # Credentials ride GITHUB_APP_* in the fleet .env.
    telegram:                                  # telegram defaults — bot stanza overrides per field
      token_env: TELEGRAM_BOT_TOKEN            # shared token (most fleets use one bot token)
      require_mention: true                    # workers respond to @-mentions only
    sandbox:
      enabled: false                         # disable sandbox per-bot (overrides global settings.json)
      auto_allow_bash: true                  # don't prompt for bash in sandbox mode
      network_allowed_domains:               # domains all bots may access without prompts
        - api.github.com
        - api.telegram.org
        - "*.anthropic.com"
      # filesystem_allow_write: []           # additional write paths (bot dir is always writable)

    # Hooks (bot-vitals.sh) and observability come from system defaults.
    # Override: declare hooks/observability here (your version wins via dedup).
    # Disable: system_defaults: false (or per-category: system_defaults: { hooks: false })
    #
    # hooks:                                       # uncomment to override system default hooks
    #   PreToolUse:
    #     - command: "$CLAUDLOBBY_ROOT/lib/bot-vitals.sh"
    #   PostToolUse:
    #     - command: "$CLAUDLOBBY_ROOT/lib/bot-vitals.sh"
    # observability:                               # uncomment to override system default values
    #   pulse_interval: 300
    #   reap_days: 7
    #   # Mirror watchdog (#1024): flag a worker that reported and was then
    #   # never re-dispatched. OFF by default — it reports that the ASSIGNMENT
    #   # loop stalled, so arm it only where someone acts on that.
    #   unassigned_check: false      # default false
    #   unassigned_threshold: 7200   # seconds idle before flagging (default 7200 = 2h)
    #   # Past max_age the check stops reporting AND clears its debounce, so a
    #   # strand outliving the window goes quiet again — set 0 to refuse that.
    #   unassigned_max_age: 86400    # stop reporting past this age (default 86400 = 24h; <=0 never stops)

  teams:
    engineering:
      manager: lead
      workers: [eng-1, reviewer-1]

  bots:
    lead:
      name: Lead                              # optional display name (defaults to dict key)
      expertise: [orchestration]              # area(s) of expertise from library/expertise/
      mission: "Coordinate the engineering team end-to-end. Dispatch work, monitor reports, surface blockers to the human within 5 minutes."
      manages: [eng-1, reviewer-1]            # bot_ids this bot manages (generates Org Structure section)
      # voice: voices/erlich-bachman.md                 # uncomment to add a personality overlay
      skills: [dispatch, fleet-pulse, fleet-status, lifecycle, prs, status, selfcheck, sweep, restart]
      mcp: [github, notion, slack]              # merges with defaults — github from defaults, notion+slack added
      protocols: [dispatch, consensus-loop, fleet-observability, fleet-dispatch-capability, canary-rollout]
      guardrails: [merge-policy-human]
      telegram:
        handle: my_lead_bot
        require_mention: false                # override: manager hears all messages in its group
      # startup_prompt accepts jinja placeholders against fleet/bot context:
      #   {{ bot_name }}, {{ fleet_name }}, {{ telegram_group_chat_id }}, {{ telegram_handle }}
      # Use them so identifiers aren't duplicated between fleet.yaml fields.
      startup_prompt: "Welcome back, {{ bot_name }}. Read your CLAUDE.md. Idle and await messages in chat {{ telegram_group_chat_id }}."

    eng-1:
      expertise: [software-engineering]
      mission: "Implement features and fix bugs in fleet repos. Branch + PR. Tests pass before report-back."
      reports_to: lead                         # bot_id of manager (generates Org Structure section)
      telegram:
        handle: my_eng_1_bot
        # token_env + require_mention inherited from defaults

    reviewer-1:
      expertise: [code-review]
      mission: "Review PRs the manager dispatches. Mutation-test assertions. Verdict-first comments. No commits, no merges."
      model: sonnet                            # reviewers run hot — Sonnet is enough
      protocols: [review-flow]
      tool_permissions:
        deny: [Write, Edit, NotebookEdit]      # reviewers read, not write
      telegram:
        handle: my_reviewer_bot
        # token_env + require_mention inherited from defaults

# ---------------------------------------------------------------------------
# Advanced options (uncomment and add to any bot stanza above)
# ---------------------------------------------------------------------------
#
#     # env — bot-specific environment variables (merged with .env files)
#     env:
#       TZ: America/New_York
#       SOME_FLAG: "true"
#
#     # resources — reference docs from library/resources/ (e.g. timezone, DB schemas)
#     resources:
#       - timezone
#
#     # lessons — library/lessons/ is FROZEN (L3). Existing referential lessons still
#     # compose for non-vault fleets; a vault-wired fleet reaches them via `claudron recall`
#     # instead. New behavior rules → protocols/guardrails; new referential findings → the
#     # vault (`claudlobby lessons-migrate`, /claudna:capture). See library/lessons/README.md.
#     lessons:
#       - review/empirical-verification
#       - telegram/mcp-drops
#
#     # principles — guiding principles from library/principles/
#     principles:
#       - visibility-and-speed
#       - consolidate-dont-fork
#
#     # post_actions — workflows to run after task completion
#     post_actions:
#       - notify-human
#
#     # mounts — symlinks to external host paths, created under <bot>/mounts/
#     mounts:
#       ha-config: /path/to/homeassistant/config  # edits write to the real location
#
#     # external_paths — bless absolute paths OUTSIDE the fleet overlay so the
#     # deny-by-default source guard lets them through. An absolute path in any
#     # compose source (env, an MCP fragment, a grant, a timer script) fails
#     # generate unless it is anchored (${FLEET_ROOT}/…, ${BOT_DIR}/…,
#     # ${CLAUDLOBBY_ROOT}/…) or declared here. Prefer anchoring for in-fleet
#     # paths; declare only genuine outside-the-fleet dependencies. `purpose` is
#     # required. A trailing /** blesses a subtree (>=2 leading segments).
#     external_paths:
#       - path: /var/lib/vendor-tool/**
#         purpose: vendored CLI tree the bot shells out to
#
#     # integrations — usage docs from library/integrations/ (auto-paired with mcp by default)
#     # Setting this explicitly overrides auto-pairing. Omit to let mcp drive it.
#     integrations: [neon, railway, vercel]
#
#     # brief — the SessionStart boot brief (#904 M1, epic #1102 R3). DEFAULT
#     # OFF. When armed, the composer adds a SessionStart hook (sources:
#     # startup + compact only) running `claudlobby brief --bot <id> --boot` —
#     # own dispatch lines + an empty-state line with provenance + the door
#     # line, token-capped (~250), fail-open, explicit 10s timeout. Arming is
#     # gated at compose time on the INSTALLED CLI serving `brief --boot`
#     # (composed settings outlive installs; generate refuses loudly if the
#     # install predates the verb). Operator-held rollout gate: arm ONE canary
#     # bot only until the canary's cost/latency numbers are ratified.
#     brief:
#       on_start: true
#
#     # briefing — equippable scheduled briefing (#627). Each slot becomes a
#     # composed per-(bot,slot) OnCalendar timer that dispatches /briefing <slot>
#     # into THIS bot's session via lib/briefing-trigger.sh — never hand-install
#     # cron. Slot names must be shell identifiers (they become the
#     # BRIEFING_SECTIONS_<SLOT> env suffix); values are systemd OnCalendar, NOT
#     # 5-field cron. BRIEFING_* lands in bot.conf for the /briefing skill; the
#     # timers enroll on `setup-fleet` and prune when a slot is removed.
#     briefing:
#       slots:
#         morning: "*-*-* 08:30:00"          # daily 08:30
#         analytics: "Sun *-*-* 17:00:00"    # weekly, Sundays 17:00 (custom slot)
#       sections:                            # optional per-slot section list
#         morning: [overnight, calendar, overdue]
#       sources: [github, gmail]             # optional data sources the skill reads
#
#     # scope — operational boundaries (org, repos the bot is allowed to touch)
#     scope:
#       org: my-github-org
#       repos: [repo-a, repo-b, repo-c]
#
#     # model_strategy — config-driven model escalation, compaction, and subagent preferences
#     # Emitted as MODEL_STRATEGY_* env vars in bot.conf for skills/protocols to read.
#     model_strategy:
#       base: sonnet                        # default model (also set via top-level `model:`)
#       escalate_to: opus                   # model to switch to for complex tasks
#       escalate_when: ">5 files or architecture decisions"
#       compact_when: "after each completed task, or on a context-degraded symptom"        # when to compact/summarize context
#       explore: haiku                      # subagent model for Explore agents
#       plan: sonnet                        # subagent model for Plan agents
#       general: sonnet                     # subagent model for general-purpose agents
#
#     # hooks — per-bot hooks (appended to fleet defaults)
#     # Use to add bot-specific behavior on top of fleet-wide logging.
#     hooks:
#       PostToolUse:
#         - command: "notify-manager.sh"          # alert manager on tool completion
#           matcher: "Bash"                       # only for Bash tool calls
#
#     # voice — personality overlay file (separate from expertise)
#     voice: voices/erlich-bachman.md
#
#     # tools — library tools (composited scripts) rendered into <bot_dir>/tools/
#     # Bare name uses manifest defaults; dict form overrides params per-bot.
#     # See library/tools/README.md for authoring.
#     tools:
#       - audit-tracker
#       - portfolio-snapshot:
#           params:
#             lookback_days: 30
#
#     # tool_permissions — control which Claude Code tools the bot may use
#     # deny: tool names the bot cannot call (generates permission deny rules)
#     # allow: tool names the bot is explicitly allowed (generates permission allow rules)
#     # Validator warns if denied tools conflict with the bot's expertise.
#     tool_permissions:
#       deny: [Write, Edit, NotebookEdit]
#       # allow: [Agent, Bash, Read, Grep, Glob]
#
#     # telegram.chat_id — override the fleet-level group for this bot
#     telegram:
#       chat_id: "-1009999999999"
#
#     # bench — marks this bot as the fleet's benchmarking target for cold-start timing.
#     # Multi-bot fleets should set bench: true on exactly one bot.
#     bench: true
#
#     # Permission model — set AT MOST ONE of the two fields below; they do NOT
#     # combine. permission_mode wins whenever it is set. With neither set, the
#     # compositor default is --permission-mode acceptEdits.
#     #
#     # Option A (preferred) — permission_mode: Claude Code --permission-mode flag.
#     # Values: default, acceptEdits, bypassPermissions, plan, dontAsk, auto
#     permission_mode: auto
#
#     # Option B — dangerously_skip_permissions: explicit opt-in to
#     # --dangerously-skip-permissions (default: false). Bypasses ALL permission
#     # prompts AND the allow/deny lists. Takes effect ONLY when permission_mode is
#     # unset (omit Option A above to use this).
#     dangerously_skip_permissions: true
#
#     # remote_control — enable --remote-control flag (default: true)
#     # Allows dispatch via tmux send-keys. Disable for standalone bots.
#     remote_control: true
#
#     # channels — Claude Code channel plugins for messaging (default: [plugin:telegram@claude-plugins-official])
#     # Override to use a different channel or disable Telegram.
#     channels:
#       - plugin:telegram@claude-plugins-official
#
#     # extra_flags — additional Claude CLI arguments appended to CLAUDE_FLAGS in bot.conf
#     extra_flags:
#       - "--verbose"
#
#     # Ecosystem fields — connect bots to clauDNA, Claudron, and Claudosseum.
#     # All optional. Can also be set in defaults: for fleet-wide values.
#     claudna_version: "0.2.0"                    # pin clauDNA plugin version
#     claudron_vault_path: "/srv/vaults/my-vault"  # points AT a vault, not into one
#     claudosseum_tenant_id: "tenant_abc123"       # Claudosseum telemetry tenant
#
#     # claudron_vault_path composes CLAUDRON_VAULT_PATH into bot.conf — the
#     # canonical vault address (Claudron CLI_CONTRACT.md §Environment). The
#     # value is a POINTER to a vault root (the directory holding `_shared/`),
#     # not a per-bot scope: one vault per tenant, and detection walks up from
#     # whatever path it is handed. Scoping happens inside the vault (fleet and
#     # project tiers), never by addressing a subdirectory here.
#
#     # claudron_session_loop — wire the bot to Claudron's session loop (L2).
#     # When on, the composer installs the engine's three lifecycle hooks into
#     # settings.local.json (SessionStart → pull + recall brief; PreCompact →
#     # the single capture prompt; SessionEnd → push) and grants the narrow verb
#     # set the model may call itself (Bash(claudron lookup|recall|capture|status *)
#     # — never a Bash(claudron *) wildcard: curation verbs like promote stay
#     # human-gated). What fires when is Claudron's CLI_CONTRACT.md §Session-loop
#     # protocol (the owner); see documentation/integrations/claudron-integration.md.
#     # Tri-state: DEFAULT is on whenever claudron_vault_path is set, off
#     # otherwise. Set it explicitly only to override that default — e.g. off on a
#     # vault-wired bot that should reach the vault by hand-run CLI alone.
#     # `claudron_session_loop: true` with no claudron_vault_path is a validate error.
#     claudron_session_loop: true
#
#     # Vault-wired MANAGER bots can also opt into the Claudron query-before
#     # preflight: dispatch-task.sh prepends fleet-memory pointers (titles +
#     # paths from `claudron lookup`) to every dispatched task. Needs the
#     # claudron CLI on the host PATH. Off unless set — see
#     # documentation/integrations/claudron-integration.md.
#     env:
#       CLAUDRON_QUERY_BEFORE: "1"
#       CLAUDRON_QUERY_LIMIT: "3"                  # max pointers per dispatch (default 3)
#
#     # autonomous_runner — turns a bot into an Autonomous Worker that picks
#     # GitHub issues from a target repo per a cadence and runs a clauDNA --auto
#     # skill (typically /claudna:implement-plan) to resolve them. The bot's
#     # CLAUDE.md gets a rendered "Autonomous Runner" section describing the job.
#     # See library/skills/autonomous-runner/{SKILL.md,archetype.md} for details.
#     autonomous_runner:
#       skill: /claudna:implement-plan            # required: which clauDNA --auto skill to run
#       cadence: 1h                                # required: how often (15m | 1h | 6h | 24h, etc.)
#       target_repo: my-org/my-repo                # required: <owner>/<repo>
#       args: ""                                   # optional: appended after --auto
#       picker:                                    # required if the skill consumes a work item
#         type: github_issues
#         label: claudna-eligible
#         state: open
#         score_by: mission_alignment              # mission_alignment | recency | priority_label
#       bypass:                                    # optional: defaults to structural-only
#         risk_classifier: structural_vs_mechanical
#         block_on: [structural]                   # [] | [structural] | [structural, localized]
#         on_bypass: comment_and_label             # comment_and_label | comment_only | exit_silent
#       pre_hooks: []                              # optional: clauDNA skills to run before main
#       post_hooks: []                             # optional: clauDNA skills to run after main
#       on_outcome:                                # optional: defaults to "report" for all outcomes
#         completed: report
#         bypassed: report
#         needs_input: report_and_pause
#         blocked: report_and_pause
#         partial: report
#
# ---------------------------------------------------------------------------
# Complete example: an Autonomous Worker bot stanza.
# Uncomment and add to bots: above to enable.
# ---------------------------------------------------------------------------
#
#     dbt-auto-bot:
#       expertise: [data-engineering]
#       mission: "Resolve claudna-eligible dbt issues during the cadence window. PRs only — never merge."
#       skills: [autonomous-runner]
#       protocols: [continuous-autonomous-mode, report-back]
#       guardrails: [no-push-main, verify-before-merge]
#       telegram:
#         handle: my_dbt_auto_bot
#       autonomous_runner:
#         skill: /claudna:implement-plan
#         cadence: 1h
#         target_repo: my-org/my-dbt-repo
#         picker:
#           type: github_issues
#           label: claudna-eligible
#           state: open
#           score_by: mission_alignment
#         bypass:
#           risk_classifier: structural_vs_mechanical
#           block_on: [structural]
#           on_bypass: comment_and_label
#         on_outcome:
#           completed: report
#           bypassed: report
#           needs_input: report_and_pause
#           blocked: report_and_pause
#           partial: report
