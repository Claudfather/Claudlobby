# claudlobby .env.example
# Copy to .env and fill in the values you need. .env is gitignored; this example is committed.
#
# Only set the variables for integrations your fleet actually uses.
# Variables are loaded by claudlobby at generate time and by bot.conf at runtime.
# See fleet.yaml.example for how bots reference these via MCP configs.

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Bot token from @BotFather — one per bot identity.
# The env var name is configurable per-bot via telegram.token_env in fleet.yaml.
# Default key name: TELEGRAM_BOT_TOKEN. Fleets with multiple bot identities
# use per-bot names like TELEGRAM_TOKEN_LEAD, TELEGRAM_TOKEN_ENG1, etc.
TELEGRAM_BOT_TOKEN=8888888888:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Fleet-wide Telegram group chat ID (starts with -100 for supergroups).
# Usually set in fleet.yaml telegram_group_chat_id, not here.
# TELEGRAM_GROUP_CHAT_ID=-1001234567890

# ---------------------------------------------------------------------------
# GitHub — MCP server: library/mcp/github.json
# ---------------------------------------------------------------------------

# Personal Access Token (classic or fine-grained).
# Needs repo, read:org scopes at minimum. Used by the GitHub MCP server.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Notion — MCP server: library/mcp/notion.json
# ---------------------------------------------------------------------------

# Internal integration token from https://www.notion.so/my-integrations.
# Multi-instance supported: NOTION_DEFAULT_TOKEN, NOTION_WORK_TOKEN, etc.
NOTION_TOKEN=ntn_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# Slack — MCP server: library/mcp/slack.json
# ---------------------------------------------------------------------------

# User OAuth token (xoxp-...). Bot-tier: different bots can use different tokens.
# Needs channels:history, channels:read, chat:write, users:read scopes.
SLACK_TOKEN=xoxp-0000000000000-0000000000000-0000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Google Workspace (Gmail + Calendar) — MCP server: library/mcp/gws.json
# ---------------------------------------------------------------------------

# OAuth 2.0 client credentials from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Per-instance settings (default instance shown; prefix with GWS_<INSTANCE>_ for multi-instance).
# Directory for stored OAuth credentials.
# CREDENTIALS_DIR=~/.config/workspace-mcp/credentials

# Google account email address.
# EMAIL=you@example.com

# Port for the workspace MCP server (each instance needs a unique port).
# PORT=3100

# ---------------------------------------------------------------------------
# Shopify — MCP server: library/mcp/shopify.json
# ---------------------------------------------------------------------------

# Admin API access token from your Shopify app.
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Store domain (e.g. mystore.myshopify.com).
SHOPIFY_STORE_DOMAIN=example-store.myshopify.com

# ---------------------------------------------------------------------------
# Spotify — MCP server: library/mcp/spotify.json
# ---------------------------------------------------------------------------

# OAuth client credentials from Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Home Assistant — MCP server: library/mcp/homeassistant.json
# ---------------------------------------------------------------------------

# Base URL of your Home Assistant instance.
HA_URL=http://homeassistant.local:8123

# Long-lived access token from HA profile page.
HA_TOKEN=eyXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXx.xxxxxxxxxxxx.xxxxxx

# ---------------------------------------------------------------------------
# Granola (meeting transcripts) — MCP server: library/mcp/granola.json
# ---------------------------------------------------------------------------

# Port for the Granola MCP remote proxy.
GRANOLA_MCP_PORT=3200

# ---------------------------------------------------------------------------
# Neon (PostgreSQL) — integration: library/integrations/neon.md
# ---------------------------------------------------------------------------

# API key from https://console.neon.tech/app/settings/api-keys.
# Used by neon CLI for branch management and database operations.
NEON_API_KEY=neon_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Railway — integration: library/integrations/railway.md
# ---------------------------------------------------------------------------

# API token for your primary Railway workspace.
RAILWAY_API_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: separate token for a personal Railway workspace.
# RAILWAY_PERSONAL_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Vercel — integration (CLI-based, no MCP server)
# ---------------------------------------------------------------------------

# Vercel CLI token. If unset, Vercel CLI uses its own login session.
# VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Snowflake — integration: library/integrations/snowflake.md
# ---------------------------------------------------------------------------

# Account identifier (e.g. xy12345.us-east-1).
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1

# Service account username.
# SNOWFLAKE_USER=MY_SERVICE_USER

# Role to assume on connection.
# SNOWFLAKE_ROLE=ANALYST

# Warehouse for query execution.
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Default database.
# SNOWFLAKE_DATABASE=ANALYTICS

# Path to RSA private key file (key-pair auth).
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_rsa_key.p8

# Inline RSA private key (alternative to path; base64-encoded).
# SNOWFLAKE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Printify — integration: library/integrations/printify.md
# ---------------------------------------------------------------------------

# API key from Printify account settings.
# PRINTIFY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shop ID (numeric).
# PRINTIFY_SHOP_ID=12345678
