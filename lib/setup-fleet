#!/bin/bash
# setup-fleet — apply the fleet layer: enroll composed fleet jobs, spin up
# bots, reconcile (setup backbone).
#
# One idempotent per-fleet APPLY+ENROLL pass over what `claudlobby generate`
# COMPOSED (this script never composes — run generate first):
#   1. jobs   — enroll every composed fleet timer via the generic enroller
#               (install_fleet_timer.sh / install_fleet_timer_launchd.sh),
#               with SERVICE_PREFIX read from fleet.yaml so a cold start
#               (no composed bot.conf yet) enrolls cleanly. Then retire a
#               prior release's legacy keepalive (step 1b — see
#               migrate_legacy_keepalive).
#   2. warm   — pre-download the fleet's npx MCP packages so the first boot is a
#               cache hit, not a simultaneous npm-install dogpile (WS-2).
#   3. bots   — spin-up-bot.sh per declared bot, SKIPPING already-healthy
#               bots (unit present + tmux session alive — reconcile-fleet's
#               healthy definition) so a re-run never bounces a working bot.
#   4. audit  — reconcile-fleet.sh (healthy/orphan/missing/unbound buckets +
#               default-job drift).
#
# Jobs listed in the composed timers/ DORMANT manifest (enroll: false in the
# jobs config) are composed-but-dormant: skipped here until a fleet opts in
# via fleet.yaml defaults.jobs.<name>.enroll: true.
#
# Per-step failures are collected, not fatal: a re-run converges (idempotent,
# resumable). Exits non-zero if anything failed.
#
# Usage: setup-fleet [<fleet-name>]
#   With a fleet name: overlay fleet at local/<fleet>/.
#   Without: root mode (fleet.yaml at $CLAUDLOBBY_ROOT — the seed flow);
#   reconcile-fleet is overlay-only and is skipped in root mode.
set -euo pipefail

FLEET="${1:-}"

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-common.sh
. "$LIB_DIR/lib-common.sh"
install_error_trap ""

if [ -n "$FLEET" ]; then
    FLEET_DIR="$CLAUDLOBBY_ROOT/local/$FLEET"
    FLEET_LABEL="$FLEET"
else
    FLEET_DIR="$CLAUDLOBBY_ROOT"
    FLEET_LABEL="root"
fi
FLEET_YAML="$FLEET_DIR/fleet.yaml"
if [ ! -f "$FLEET_YAML" ]; then
    echo "setup-fleet: $FLEET_YAML not found — pass an overlay fleet name, or run root mode from a repo with a root fleet.yaml" >&2
    exit 1
fi
# Derived from FLEET_DIR (not resolve_bots_dir): the env fallback there
# (CLAUDLOBBY_FLEET/FLEET_NAME, exported by every bot.conf) would split-brain
# a root-mode run from inside a bot session onto another fleet's bots dir.
BOTS_DIR="$FLEET_DIR/runtime/bots"
TIMERS_DIR="$FLEET_DIR/runtime/fleet/timers"

log() { printf 'setup-fleet[%s]: %s\n' "$FLEET_LABEL" "$*"; }
FAILURES=0

# Cold-start fix: the prefix comes from fleet.yaml, not from scanning a
# composed bot.conf — enrollment has no ordering dependency on bot output.
# Passed per enroller invocation (not exported) so it never bleeds into
# spin-up-bot.sh / reconcile-fleet.sh descendants.
SERVICE_PREFIX="$(fleet_service_prefix "$FLEET_YAML")"
log "service_prefix: $SERVICE_PREFIX (from fleet.yaml)"

# --- 1. fleet jobs ------------------------------------------------------------
enroll_jobs() {
    log "step 1/4: enroll composed fleet jobs"
    if [ ! -d "$TIMERS_DIR" ]; then
        log "no composed timers at $TIMERS_DIR — run 'claudlobby generate' first"
        FAILURES=$((FAILURES + 1))
        return
    fi
    local enroller ext t base jobname found=0
    if [ "$_OS" = "Linux" ]; then
        enroller="$LIB_DIR/install_fleet_timer.sh"
        ext="timer"
    else
        enroller="$LIB_DIR/install_fleet_timer_launchd.sh"
        ext="plist"
    fi
    for t in "$TIMERS_DIR/$SERVICE_PREFIX".*."$ext"; do
        [ -e "$t" ] || continue
        found=1
        base="$(basename "$t" ".$ext")" # <prefix>.<job>
        jobname="${base#"$SERVICE_PREFIX".}"
        # Composed-but-dormant (enroll: false) — a fleet opts in via
        # defaults.jobs.<name>.enroll: true.
        if unit_is_dormant "$TIMERS_DIR" "$base"; then
            log "· dormant (opt-in): $base — enable via fleet.yaml defaults.jobs.$jobname.enroll: true"
            continue
        fi
        # TIMER_DIR + SERVICE_PREFIX per invocation: one call shape for
        # overlay and root mode (matches setup-system's host-jobs idiom).
        if TIMER_DIR="$TIMERS_DIR" SERVICE_PREFIX="$SERVICE_PREFIX" "$enroller" "$jobname"; then
            log "✓ job enrolled: $base"
        else
            log "○ job enrollment FAILED: $base (re-run converges)"
            FAILURES=$((FAILURES + 1))
        fi
    done
    [ "$found" = 1 ] || log "no $SERVICE_PREFIX.*.$ext units in $TIMERS_DIR"
}

# --- 1b. legacy keepalive migration (Phase 6 / F6=a) ---------------------------
# A prior release enrolled keepalive as claudlobby-<fleet>-keepalive; the
# composed name is <service_prefix>.keepalive. Once the new unit is enrolled,
# ACTIVE, and has completed a verification run, retire the legacy unit — never
# the reverse. During the swap supervision coverage is a union (both timers),
# never zero; every abort path leaves the legacy unit fully untouched.
# Rehearse first: lib/rehearse-keepalive-swap.sh (gate 1, journal-proven).
migrate_legacy_keepalive() {
    # Root mode has no fleet name, so the legacy scheme cannot apply. Scope is
    # the systemd spelling only: every live legacy fleet is Linux, and macOS's
    # own legacy label (pre-#289 com.claudlobby.<fleet>.keepalive) is a
    # different scheme, out of F6 scope — extend here if one ever surfaces.
    [ -n "$FLEET" ] || return 0
    [ "$_OS" = "Linux" ] || return 0
    local legacy="claudlobby-$FLEET-keepalive" new="$SERVICE_PREFIX.keepalive" out
    # Probe the unit registry — never assume the legacy unit is present (F6).
    out=$(systemctl --user list-unit-files --no-legend "$legacy.timer" 2>/dev/null || true)
    [ -n "$out" ] || return 0
    log "step 1b: legacy keepalive detected ($legacy) — staged swap to $new"
    # Gate: the new timer must be live before the old one is touched.
    if ! systemctl --user is-active "$new.timer" >/dev/null 2>&1; then
        log "○ swap ABORTED: $new.timer is not active — legacy unit left running"
        FAILURES=$((FAILURES + 1))
        return
    fi
    # Gate: prove a supervision pass completes under the new unit NOW. The
    # synchronous oneshot run also re-anchors OnUnitActiveSec, so the next
    # tick is contractually <=60s out — the no-gap window closes before the
    # legacy unit is disabled.
    if ! systemctl --user start "$new.service"; then
        log "○ swap ABORTED: $new.service verification run failed — legacy unit left running"
        FAILURES=$((FAILURES + 1))
        return
    fi
    if systemctl --user disable --now "$legacy.timer"; then
        rm -f "$HOME/.config/systemd/user/$legacy.timer" \
              "$HOME/.config/systemd/user/$legacy.service"
        systemctl --user daemon-reload
        log "✓ legacy keepalive retired: $legacy ($new verified live)"
    else
        # New unit IS live — worst case here is double coverage, never a gap.
        log "○ legacy disable failed ($legacy) — $new is live (no gap); re-run to retry cleanup"
        FAILURES=$((FAILURES + 1))
    fi
}

# --- 1c. briefing timer reconcile (F3 / #627) ---------------------------------
# The briefing family is the first DYNAMIC per-(bot,slot) timer set: a renamed
# or removed slot leaves an enrolled orphan that fires forever. enroll_jobs is
# additive glob-enroll and never disables, so this is the disable half — the
# enroll-side twin of the composer generate-time prune (_reconcile_briefing_units).
# Models migrate_legacy_keepalive gate discipline + spin-down-bot.sh teardown;
# reconcile-fleet.sh (step 4) already AUDITS such job drift, this acts on the
# briefing subset. Cross-platform, dry-run-logged, glob-bounded to
# <prefix>.briefing-*, with an abort-on-degenerate guard so a bad (or not-yet-run)
# generate can never disable every live briefing timer. Enumerates the LIVE
# ENROLLED set, not the composed dir.
reconcile_briefing_timers() {
    [ -n "$FLEET" ] || return 0      # root mode has no fleet timers
    [ -d "$TIMERS_DIR" ] || return 0 # nothing composed -> nothing to reconcile
    local ext c base
    if [ "$_OS" = "Linux" ]; then ext="timer"; else ext="plist"; fi

    # Composed set: <prefix>.briefing-* basenames just written by generate.
    local composed=()
    for c in "$TIMERS_DIR/$SERVICE_PREFIX".briefing-*."$ext"; do
        [ -e "$c" ] || continue
        composed+=("$(basename "$c" ".$ext")")
    done

    # Live ENROLLED set (the real firing units), not the composed dir.
    local enrolled=() unit label uid
    if [ "$_OS" = "Linux" ]; then
        while IFS= read -r unit; do
            [ -n "$unit" ] && enrolled+=("${unit%.timer}")
        done < <(systemctl --user list-unit-files --no-legend \
            "$SERVICE_PREFIX.briefing-*.timer" 2>/dev/null | awk '{print $1}')
    else
        uid="$(id -u)"
        for c in "$HOME/Library/LaunchAgents/$SERVICE_PREFIX".briefing-*.plist; do
            [ -e "$c" ] || continue
            label="$(basename "$c" .plist)"
            launchctl print "gui/$uid/$label" >/dev/null 2>&1 && enrolled+=("$label")
        done
    fi
    [ "${#enrolled[@]}" -gt 0 ] || return 0 # no live briefing units to reconcile

    # Orphans = enrolled - composed.
    local orphans=() e is_composed
    for e in "${enrolled[@]}"; do
        is_composed=0
        for base in "${composed[@]:-}"; do
            [ "$e" = "$base" ] && { is_composed=1; break; }
        done
        [ "$is_composed" = 0 ] && orphans+=("$e")
    done
    [ "${#orphans[@]}" -gt 0 ] || return 0

    # Abort-on-degenerate (verify-before-disable): nothing composed yet live units
    # exist means a bad or not-yet-run generate — refuse the wholesale disable,
    # dry-run-log, leave them running. A real full removal is done by hand from
    # this log (rare; the generate side already pruned the unit files).
    if [ "${#composed[@]}" -eq 0 ]; then
        log "○ briefing reconcile ABORTED (degenerate): composed set empty while ${#enrolled[@]} briefing timer(s) live — NOT disabling; re-run 'claudlobby generate' or remove by hand"
        for e in "${orphans[@]}"; do log "  would-disable (skipped): $e"; done
        return 0
    fi

    # Dry-run-log every orphan first (forensic), then disable — glob-guarded so
    # only <prefix>.briefing-* units can ever be touched.
    local o
    for o in "${orphans[@]}"; do log "· briefing orphan (will disable): $o"; done
    for o in "${orphans[@]}"; do
        case "$o" in
        "$SERVICE_PREFIX".briefing-*) : ;;
        *)
            log "○ glob-guard refused non-briefing unit: $o"
            continue
            ;;
        esac
        if [ "$_OS" = "Linux" ]; then
            systemctl --user disable --now "$o.timer" 2>/dev/null || true
            rm -f "$HOME/.config/systemd/user/$o.timer" \
                "$HOME/.config/systemd/user/$o.service"
            systemctl --user daemon-reload 2>/dev/null || true
            systemctl --user reset-failed "$o.timer" 2>/dev/null || true
        else
            /bin/launchctl bootout "gui/$(id -u)/$o" 2>/dev/null || true
            rm -f "$HOME/Library/LaunchAgents/$o.plist"
        fi
        log "✓ briefing orphan disabled + removed: $o"
    done
}

# --- 2. warm npx cache (before spin-up) ---------------------------------------
warm_npx_cache() {
    # Skip when every declared bot is already healthy — those running bots are
    # executing these MCP servers now, so the cache is provably warm. Matches the
    # script's skip-when-healthy discipline (spin_up_bots) and confines the warm
    # to actual cold-boot paths — the only time the dogpile can fire.
    local defined b need=0
    defined=$(parse_fleet_bots "$FLEET_YAML")
    while IFS= read -r b; do
        [ -z "$b" ] && continue
        if ! bot_is_healthy "$b" "$BOTS_DIR/$b" 2>/dev/null; then need=1; break; fi
    done <<<"$defined"
    if [ "$need" = 0 ]; then
        log "step 2/4: warm npx cache — all bots healthy, cache already warm (skip)"
        return
    fi
    log "step 2/4: warm npx cache (pre-boot)"
    # Bots launch their MCP servers via `npx -y <pkg>` on spin-up. On a cold
    # ~/.npm/_npx cache a whole fleet booting together dogpiles the same
    # npm-install simultaneously (cold ~10-30s each on a Pi) — the cold-start MCP
    # dogpile that can leave servers dark on reboot. Warm the fleet's packages
    # here, right before spin-up, so the first boot is a cache HIT. Non-fatal
    # (mirrors reload-fleet): a miss just means the first MCP init cold-downloads;
    # the cache is host-shared (~/.npm/_npx), so only the first fetch hits network.
    # shellcheck disable=SC2086
    if claudlobby ${FLEET:+--fleet "$FLEET"} warm-cache >/dev/null 2>&1; then
        log "✓ npx cache warmed"
    else
        log "○ warm-cache skipped/failed (non-fatal — first MCP init cold-downloads)"
    fi
}

# --- 3. bots (skip healthy) ----------------------------------------------------
bot_is_healthy() {
    # reconcile-fleet's healthy definition: unit present AND tmux session
    # alive on the bot's own socket — built from the same shared predicates
    # (bot_unit_present, check_tmux_session), so a bot setup-fleet skips is
    # exactly one reconcile reports healthy, and spin-up-bot.sh (which
    # restarts) only ever runs on unhealthy bots.
    local bot="$1" bot_dir="$2" sock
    sock=$(tmux_socket_for_bot "$bot_dir" 2>/dev/null || true)
    check_tmux_session "$bot" "$sock" 2>/dev/null || return 1
    bot_unit_present "$bot" "$bot_dir"
}

spin_up_bots() {
    log "step 3/4: spin up bots (skip healthy)"
    local defined b bot_dir
    defined=$(parse_fleet_bots "$FLEET_YAML")
    if [ -z "$defined" ]; then
        log "no bots declared in fleet.yaml"
        return
    fi
    while IFS= read -r b; do
        [ -z "$b" ] && continue
        bot_dir="$BOTS_DIR/$b"
        if [ ! -d "$bot_dir" ]; then
            log "○ $b: no runtime dir at $bot_dir — run 'claudlobby generate' first"
            FAILURES=$((FAILURES + 1))
            continue
        fi
        if bot_is_healthy "$b" "$bot_dir"; then
            log "✓ $b: already healthy — skipping (no restart)"
            continue
        fi
        if "$LIB_DIR/spin-up-bot.sh" "$bot_dir"; then
            log "✓ $b: spun up"
        else
            log "○ $b: spin-up FAILED (re-run converges)"
            FAILURES=$((FAILURES + 1))
        fi
    done <<<"$defined"
}

# --- 4. reconcile audit ---------------------------------------------------------
reconcile() {
    if [ -z "$FLEET" ]; then
        log "step 4/4: reconcile audit skipped — reconcile-fleet is overlay-only (root mode)"
        return
    fi
    log "step 4/4: reconcile audit"
    "$LIB_DIR/reconcile-fleet.sh" "$FLEET" || FAILURES=$((FAILURES + 1))
}

reconcile_briefing_timers
enroll_jobs
migrate_legacy_keepalive
warm_npx_cache
spin_up_bots
reconcile

if [ "$FAILURES" -gt 0 ]; then
    log "done with $FAILURES failure(s) — fix + re-run (idempotent)"
    exit 1
fi
log "done — jobs enrolled, bots up, reconcile ran"
