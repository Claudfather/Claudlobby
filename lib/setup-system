#!/bin/bash
# setup-system — apply the host layer of system.yaml (setup backbone).
#
# Cross-platform host setup for a claudlobby fleet host, plus enrollment of
# the host-global jobs (system.yaml host.jobs) under their fixed
# claudlobby-<name> identity. Idempotent: detects what's already in place and
# only does the missing work. Re-running is safe.
#
# Boundary: `claudlobby generate` COMPOSES; setup-system APPLIES + ENROLLS.
# Per-fleet bring-up is setup-fleet's job (this script is once-per-host).
#
# Usage:
#   lib/setup-system                 # install prereqs + enroll host jobs
#   lib/setup-system --dry-run       # report what would change, do nothing
#   lib/setup-system --help          # show this usage text
#
# Supported hosts:
#   - Raspberry Pi 5 (Debian bookworm arm64)
#   - macOS Sonoma+ (arm64 / x86_64)
#
# Phases (each no-ops if its target is already in place):
#    1. preflight        — OS/arch detection, repo root check
#    2. packages         — package manager + core CLI tools (tmux, jq, gh)
#    3. node             — node + npm; note bun availability
#    4. python           — python3 3.10+ check, pip install claudlobby
#    5. claude           — claude CLI + authentication check
#    6. plugins          — Telegram plugin + Claudfather plugin
#    7. managed-settings — claude-code channel-plugin approvals (managed file)
#    8. systemd          — Linux only: linger + XDG_RUNTIME_DIR
#    9. host-jobs        — compose + enroll system.yaml host.jobs timers
#   10. report           — summary matrix + next steps

set -euo pipefail

DRY_RUN=0

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)    DRY_RUN=1; shift ;;
        -h|--help)
            sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            echo "setup-system: unknown arg: $1" >&2
            exit 2
            ;;
    esac
done

# Resolve repo root and source shared helpers
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLAUDLOBBY_ROOT="${CLAUDLOBBY_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd)}"
export CLAUDLOBBY_ROOT
# shellcheck source=lib-common.sh
. "$SCRIPT_DIR/lib-common.sh"
install_error_trap ""

log()  { printf 'setup-system: %s\n' "$*"; }
ok()   { printf 'setup-system: \xe2\x9c\x93 %s\n' "$*"; }   # checkmark
miss() { printf 'setup-system: \xe2\x97\x8b %s\n' "$*"; }   # circle
run()  {
    if [ "$DRY_RUN" = 1 ]; then
        printf 'setup-system: [dry-run] would run: %s\n' "$*"
    else
        "$@"
    fi
}

# record_install_outcome <name>
# Record the result of an install that `run` may have SKIPPED.
#
# Under --dry-run nothing was installed, so the thing is still missing. Saying
# otherwise is not cosmetic: the /setup skill is explicitly told to run this
# script with --dry-run and parse its output instead of doing its own checks, so
# a success recorded here sends the guided flow past a genuinely absent
# dependency. Phase 4 shipped exactly that and printed "prereqs missing: (none)"
# on a host with no claudlobby at all.
#
# Prefer run_tracked below. This exists for the sites that cannot use it — an
# install that is several commands, or one already wrapped in its own DRY_RUN
# guard — where the outcome still has to be recorded as a separate statement.
record_install_outcome() {
    local name="$1"
    if [ "$DRY_RUN" = 1 ]; then
        PREREQ_MISSING+=("$name")
        NEXT_STEPS+=("Re-run without --dry-run to install $name")
    else
        PREREQ_OK+=("$name")
    fi
}

# run_tracked <name> <cmd...>
# Execute (or, under --dry-run, announce and skip) AND record the outcome, in
# one call.
#
# This shape exists because the bug it replaces was structural, not clerical.
# `run` returns 0 whether it executed or skipped, so its exit status cannot tell
# the two apart — which forced every caller to record the outcome in a SECOND,
# separate, forgettable statement. Three phases forgot it in different ways, and
# two of those survived the first fix precisely because the fix patched the
# sites someone had noticed rather than the obligation itself. With execute and
# record collapsed into one call there is no trailing statement left to omit.
#
# RETURN CONTRACT: non-zero when the command was SKIPPED (--dry-run) or FAILED;
# zero only when it actually ran and succeeded. Never call it bare under
# `set -e` — guard with `|| true` when the outcome is only collected for the
# summary, or with `if` when you need to branch. A bare call aborts the dry-run.
run_tracked() {
    local name="$1"; shift
    if [ "$DRY_RUN" = 1 ]; then
        printf 'setup-system: [dry-run] would run: %s\n' "$*"
        PREREQ_MISSING+=("$name")
        NEXT_STEPS+=("Re-run without --dry-run to install $name")
        return 1
    fi
    if "$@"; then
        PREREQ_OK+=("$name")
        return 0
    fi
    miss "$name install failed"
    PREREQ_MISSING+=("$name")
    NEXT_STEPS+=("Install $name manually — its install command failed above")
    return 1
}

PREREQ_OK=()
PREREQ_MISSING=()
NEXT_STEPS=()

# ---------------------------------------------------------------------------
# 1. preflight — OS/arch detection, repo root check
# ---------------------------------------------------------------------------
phase_preflight() {
    log "phase 1/10: preflight"
    local arch
    arch="$(uname -m)"
    if [ "$_OS" != "Darwin" ] && [ "$_OS" != "Linux" ]; then
        echo "setup-system: unsupported OS (uname=$_OS). Supported: Linux, Darwin." >&2
        exit 1
    fi
    if [ ! -d "$CLAUDLOBBY_ROOT" ]; then
        echo "setup-system: claudlobby checkout not found at $CLAUDLOBBY_ROOT" >&2
        echo "setup-system: clone the repo first, or set CLAUDLOBBY_ROOT to its location" >&2
        exit 1
    fi
    if [ ! -f "$CLAUDLOBBY_ROOT/lib/lib-common.sh" ]; then
        echo "setup-system: $CLAUDLOBBY_ROOT does not look like a claudlobby repo (missing lib/lib-common.sh)" >&2
        exit 1
    fi
    ok "$_OS $arch, CLAUDLOBBY_ROOT=$CLAUDLOBBY_ROOT"
}

# ---------------------------------------------------------------------------
# 2. packages — package manager + core CLI tools
# ---------------------------------------------------------------------------
ensure_apt_pkg() {
    local pkg="$1"
    if dpkg -l "$pkg" 2>/dev/null | grep -q "^ii"; then
        ok "apt $pkg already installed"
        PREREQ_OK+=("$pkg")
    else
        miss "apt $pkg missing — installing"
        run_tracked "$pkg" sudo apt-get install -y -qq "$pkg" || true
    fi
}

ensure_brew_pkg() {
    local pkg="$1"
    local found
    # Ask whether the tool is USABLE, not whether brew is what installed it.
    # A stock macOS ships jq at /usr/bin/jq via the Xcode CLT, and MacPorts, nix
    # and asdf all place working binaries outside the brew prefix. Testing
    # `brew list` alone reported every such host as missing and reinstalled on
    # top of a perfectly good tool.
    if found="$(command -v "$pkg" 2>/dev/null)"; then
        ok "$pkg already available ($found)"
        PREREQ_OK+=("$pkg")
    elif brew list --formula "$pkg" >/dev/null 2>&1; then
        ok "brew $pkg already installed"
        PREREQ_OK+=("$pkg")
    else
        miss "brew $pkg missing — installing"
        run_tracked "$pkg" brew install --quiet "$pkg" || true
    fi
}

# _claudlobby_importable
# True when the claudlobby package is actually USABLE. Imports a module that
# pulls the third-party deps, so a bare package directory on sys.path with
# nothing installed cannot register as a false positive — the same trap
# claudlobby_cli hit (a plain `import claudlobby` succeeds from cwd with zero
# dependencies present).
_claudlobby_importable() {
    local venv_py="$CLAUDLOBBY_ROOT/.venv/bin/python"
    if [ -x "$venv_py" ] && ( cd "$CLAUDLOBBY_ROOT" && "$venv_py" -c 'import claudlobby.composer' ) >/dev/null 2>&1; then
        return 0
    fi
    ( cd "$CLAUDLOBBY_ROOT" && python3 -c 'import claudlobby.composer' ) >/dev/null 2>&1
}

phase_packages() {
    log "phase 2/10: package manager + core CLI tools"
    if [ "$_OS" = "Linux" ]; then
        # Ensure apt cache is reasonably fresh
        if [ "$DRY_RUN" != 1 ]; then
            sudo apt-get update -qq
        fi
        for pkg in tmux jq curl; do
            ensure_apt_pkg "$pkg"
        done
        # gh (GitHub CLI) — may need dedicated repo on Debian
        if command -v gh >/dev/null 2>&1; then
            ok "gh already installed"
            PREREQ_OK+=("gh")
        else
            miss "gh missing — installing"
            if [ "$DRY_RUN" != 1 ]; then
                # Install gh from official apt repo
                sudo mkdir -p -m 755 /etc/apt/keyrings
                curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
                sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
                echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli-stable.list >/dev/null
                sudo apt-get update -qq
                sudo apt-get install -y -qq gh
            else
                printf 'setup-system: [dry-run] would run: install gh from GitHub apt repo\n'
            fi
            record_install_outcome gh
        fi
    elif [ "$_OS" = "Darwin" ]; then
        if ! command -v brew >/dev/null 2>&1; then
            miss "homebrew missing — installing"
            # Guarded, not `run`-wrapped: `run` decides to skip only AFTER the
            # shell has expanded its arguments, so a $( curl ... ) here downloads
            # the 36KB installer on every --dry-run — a live network call inside
            # the test suite, and inside a preview that promises to touch nothing.
            if [ "$DRY_RUN" = 1 ]; then
                printf 'setup-system: [dry-run] would run: install homebrew from raw.githubusercontent.com\n'
            else
                /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            fi
        else
            ok "homebrew already installed"
        fi
        for pkg in tmux jq gh; do
            ensure_brew_pkg "$pkg"
        done
    fi
}

# ---------------------------------------------------------------------------
# 3. node — check for node; install if missing; note bun
# ---------------------------------------------------------------------------
phase_node() {
    log "phase 3/10: node"
    local need_install=0
    if command -v node >/dev/null 2>&1; then
        local node_version node_major
        node_version="$(node --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || echo '0.0.0')"
        node_major="$(echo "$node_version" | cut -d. -f1)"
        if [ "$node_major" -lt 18 ]; then
            miss "node v$node_version found — 18+ required"
            need_install=1
        else
            ok "node v$node_version already installed"
            PREREQ_OK+=("node")
        fi
    else
        miss "node missing — installing"
        need_install=1
    fi

    if [ "$need_install" -eq 1 ]; then
        if [ "$_OS" = "Linux" ]; then
            # NodeSource provides current LTS; Debian stock nodejs may be too old
            if [ "$DRY_RUN" != 1 ]; then
                curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - >/dev/null 2>&1
                sudo apt-get install -y -qq nodejs
            else
                printf 'setup-system: [dry-run] would run: install node 20.x via NodeSource\n'
            fi
        elif [ "$_OS" = "Darwin" ]; then
            run brew install --quiet node
        fi
        # Not PREREQ_OK unconditionally: under --dry-run nothing was installed.
        # This branch prints no checkmark, so the false claim surfaced only in
        # the summary array — invisible to a test that scans for a tick.
        record_install_outcome node
    fi

    # Note bun availability (informational only)
    if command -v bun >/dev/null 2>&1; then
        local bun_version
        bun_version="$(bun --version 2>/dev/null || echo 'unknown')"
        ok "bun $bun_version available"
    else
        log "bun not found (optional — not installing)"
    fi
}

# ---------------------------------------------------------------------------
# 4. python — ensure python3 3.10+, install claudlobby package
# ---------------------------------------------------------------------------
phase_python() {
    log "phase 4/10: python"
    if ! command -v python3 >/dev/null 2>&1; then
        miss "python3 not found"
        PREREQ_MISSING+=("python3")
        NEXT_STEPS+=("Install Python 3.10+ manually, then re-run this script")
        return
    fi

    local py_version py_major py_minor
    py_version="$(python3 --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')"
    py_major="$(echo "$py_version" | cut -d. -f1)"
    py_minor="$(echo "$py_version" | cut -d. -f2)"

    if [ "$py_major" -lt 3 ] || { [ "$py_major" -eq 3 ] && [ "$py_minor" -lt 10 ]; }; then
        miss "python3 $py_version found — 3.10+ required"
        PREREQ_MISSING+=("python3 (need 3.10+, have $py_version)")
        NEXT_STEPS+=("Upgrade Python to 3.10+ manually, then re-run this script")
        return
    fi

    ok "python3 $py_version"
    PREREQ_OK+=("python3")

    # Install the claudlobby package.
    #
    # PEP 668 marks Homebrew python and Debian/Pi system python as
    # externally-managed, so `python3 -m pip install -e` into the interpreter is
    # REFUSED outright on both first-class hosts. A repo-local venv is the only
    # install shape that works unattended everywhere, and it is what
    # getting-started.md documents; claudlobby_cli prefers the same venv so
    # supervised launchd/systemd invocations resolve without an activated shell.
    local venv_dir="$CLAUDLOBBY_ROOT/.venv"
    local venv_py="$venv_dir/bin/python"

    # Already usable — nothing to do, in either mode.
    if _claudlobby_importable; then
        ok "claudlobby package installed"
        PREREQ_OK+=("claudlobby-pip")
        return
    fi

    log "installing claudlobby package into $venv_dir"
    if [ "$DRY_RUN" = 1 ]; then
        printf 'setup-system: [dry-run] would run: python3 -m venv %s && %s -m pip install -e %s\n' \
            "$venv_dir" "$venv_py" "$CLAUDLOBBY_ROOT"
        # Report the state that ACTUALLY holds right now. Reporting the
        # post-condition of an action dry-run did not take produced a false
        # green ("prereqs missing: (none)") on a host with no claudlobby at all
        # — and the /setup skill is told to parse this output and skip ahead.
        miss "claudlobby package not installed yet"
        PREREQ_MISSING+=("claudlobby-pip")
        NEXT_STEPS+=("Re-run without --dry-run to create $venv_dir and install claudlobby")
        return
    fi

    [ -x "$venv_py" ] || run python3 -m venv "$venv_dir"
    "$venv_py" -m pip install -e "$CLAUDLOBBY_ROOT" --quiet 2>&1 || {
        miss "pip install claudlobby failed — see output above"
        PREREQ_MISSING+=("claudlobby-pip")
        NEXT_STEPS+=("Run '$venv_py -m pip install -e $CLAUDLOBBY_ROOT' manually to debug")
        return
    }

    # Verify the post-condition instead of asserting it.
    if _claudlobby_importable; then
        ok "claudlobby package installed"
        PREREQ_OK+=("claudlobby-pip")
    else
        miss "claudlobby installed but not importable"
        PREREQ_MISSING+=("claudlobby-pip")
        NEXT_STEPS+=("Debug with '$venv_py -m claudlobby --help'")
    fi
}

# ---------------------------------------------------------------------------
# 5. claude — CLI check + auth status
# ---------------------------------------------------------------------------
phase_claude() {
    log "phase 5/10: claude CLI"
    local claude_bin=""
    if [ -x "$HOME/.local/bin/claude" ]; then
        claude_bin="$HOME/.local/bin/claude"
    elif [ -n "${_HOMEBREW:-}" ] && [ -x "$_HOMEBREW/bin/claude" ]; then
        claude_bin="$_HOMEBREW/bin/claude"
    elif claude_bin="$(command -v claude 2>/dev/null)" && [ -n "$claude_bin" ]; then
        :
    else
        claude_bin=""
    fi

    if [ -z "$claude_bin" ]; then
        miss "claude CLI missing — installing via npm"
        run npm install -g @anthropic-ai/claude-code
        NEXT_STEPS+=("Run 'claude /login' once to authenticate (OAuth, browser)")
        PREREQ_MISSING+=("claude (login required)")
        return
    fi

    ok "claude found at $claude_bin"
    PREREQ_OK+=("claude")

    # Check auth status if the command supports it
    if "$claude_bin" auth status >/dev/null 2>&1; then
        ok "claude auth: authenticated"
    else
        miss "claude auth: not authenticated or check unavailable"
        NEXT_STEPS+=("Run 'claude /login' to authenticate (OAuth, browser)")
    fi
}

# ---------------------------------------------------------------------------
# 6. plugins — Telegram + Claudfather
# ---------------------------------------------------------------------------
phase_plugins() {
    log "phase 6/10: plugins"
    local claude_bin=""
    claude_bin="$(command -v claude 2>/dev/null)" || true
    if [ -z "$claude_bin" ]; then
        miss "claude CLI not available — skipping plugin install"
        return
    fi

    local plugin_list=""
    plugin_list="$("$claude_bin" plugin list 2>/dev/null)" || true

    # Telegram plugin
    if echo "$plugin_list" | grep -qi telegram; then
        ok "telegram plugin already installed"
    else
        miss "telegram plugin missing — installing"
        run "$claude_bin" plugin install "telegram@claude-plugins-official"
    fi

    # Claudfather marketplace + plugin
    if echo "$plugin_list" | grep -qi claudna; then
        ok "claudna plugin already installed"
    else
        miss "claudna plugin missing — adding marketplace + installing"
        if [ "$DRY_RUN" != 1 ]; then
            "$claude_bin" plugin marketplace add Claudfather/clauDNA || true
            "$claude_bin" plugin install "claudna@Claudfather" 2>/dev/null || {
                miss "claudna plugin install failed — may need manual install"
                NEXT_STEPS+=("Run 'claude plugin marketplace add Claudfather/clauDNA && claude plugin install claudna@Claudfather' manually")
                return
            }
        else
            printf 'setup-system: [dry-run] would run: claude plugin marketplace add Claudfather/clauDNA + install claudna\n'
            miss "claudna plugin still missing (dry-run made no changes)"
            NEXT_STEPS+=("Re-run without --dry-run to install the claudna plugin")
            return
        fi
        ok "claudna plugin installed"
    fi
}

# ---------------------------------------------------------------------------
# 7. managed-settings — claude-code channel-plugin approvals (managed file)
# ---------------------------------------------------------------------------
# WHY: claude-code gates channel-plugin INBOUND notification registration on an
# allowlist compiled into the binary. The ONLY runtime override is
# allowedChannelPlugins in MANAGED settings — project/user settings.json are
# ignored for this key, and the env-path override is ignored for the top-level
# session. So this managed file is the one surface that keeps a channel plugin
# from a non-ledger marketplace (a fork, e.g. our prefer-live-holder telegram
# fork) inbound-alive; without it, such a plugin silently goes deaf on every
# session (re)start, including the daily reload.
#
# The approval list is INLINE, not fleet config: it is the fixed set of channel
# marketplaces this claudlobby build ships for, and it changes only when that
# set does (a code change, reviewed). Setting allowedChannelPlugins REPLACES
# claude-code's built-in ledger wholesale, so the list MUST enumerate the
# official marketplace too, never just the fork, or official channels get
# de-approved. We deep-merge into the OS file (preserving unrelated managed
# keys) and dedupe the list, so re-runs are byte-stable.
MANAGED_CHANNEL_APPROVALS='{"allowedChannelPlugins":[{"marketplace":"claude-plugins-official","plugin":"telegram"},{"marketplace":"claudfather-plugins","plugin":"telegram"}]}'

phase_managed_settings() {
    log "phase 7/10: managed settings"

    local dir target count
    if [ "$_OS" = "Darwin" ]; then
        dir="/Library/Application Support/ClaudeCode"
    else
        dir="/etc/claude-code"
    fi
    target="$dir/managed-settings.json"
    # jq is itself a prereq this script installs, so it may legitimately be
    # absent here. Computing the count unguarded killed the run at phase 7 on a
    # jq-less host — phases 8-10 and the whole summary never printed, and the
    # /setup skill is told to parse that summary.
    count="$(printf '%s' "$MANAGED_CHANNEL_APPROVALS" | jq '.allowedChannelPlugins | length' 2>/dev/null)" || count=""
    [ -n "$count" ] || count="an unknown number of"

    if [ "$DRY_RUN" = 1 ]; then
        printf 'setup-system: [dry-run] would write %s with %s channel-plugin approvals\n' "$target" "$count"
        return
    fi

    # Idempotent merge: preserve any unrelated top-level keys already in the
    # managed file (deep-merge via jq `*`), then set allowedChannelPlugins to
    # the deduped union of existing + desired. `unique` sorts, so repeated runs
    # converge on the same bytes. The file is root-owned -> read via sudo cat
    # (absent -> treat as {}), write via the sudo-tee idiom.
    local existing
    existing="$(sudo cat "$target" 2>/dev/null || printf '{}')"
    [ -n "$existing" ] || existing='{}'

    local merged
    if ! merged="$(jq -n --argjson existing "$existing" --argjson desired "$MANAGED_CHANNEL_APPROVALS" \
        '$existing * $desired
         | .allowedChannelPlugins = (
             (($existing.allowedChannelPlugins // []) + $desired.allowedChannelPlugins)
             | unique)')"; then
        miss "managed settings merge failed (unparseable $target?) — left untouched"
        NEXT_STEPS+=("Inspect $target for invalid JSON, then re-run lib/setup-system")
        return
    fi

    local tmp
    tmp="$(safe_mktemp)"
    printf '%s\n' "$merged" > "$tmp"
    sudo mkdir -p "$dir"
    sudo tee "$target" >/dev/null < "$tmp"
    ok "managed settings written: $target ($count channel-plugin approvals)"
}

# ---------------------------------------------------------------------------
# 8. systemd — Linux only: linger + XDG_RUNTIME_DIR
# ---------------------------------------------------------------------------
phase_systemd() {
    if [ "$_OS" != "Linux" ]; then
        log "phase 8/10: systemd (skipped — not Linux)"
        return
    fi
    log "phase 8/10: systemd setup"

    # Check loginctl linger
    local linger_status=""
    linger_status="$(loginctl show-user "$USER" --property=Linger 2>/dev/null)" || true
    if [ "$linger_status" = "Linger=yes" ]; then
        ok "loginctl linger enabled for $USER"
    else
        miss "loginctl linger not enabled — enabling"
        if run_tracked loginctl-linger sudo loginctl enable-linger "$USER"; then
            ok "loginctl linger enabled"
        else
            # Without linger, user units do not survive logout — phase 9 would
            # enroll timers that silently never fire once the session ends.
            NEXT_STEPS+=("Enable linger: sudo loginctl enable-linger $USER (user timers do not survive logout without it)")
        fi
    fi

    # Check XDG_RUNTIME_DIR
    if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "${XDG_RUNTIME_DIR}" ]; then
        ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    else
        miss "XDG_RUNTIME_DIR not set or missing"
        NEXT_STEPS+=("Ensure XDG_RUNTIME_DIR is set (typically /run/user/\$(id -u)) — systemd user services require it")
    fi
}

# ---------------------------------------------------------------------------
# 9. host-jobs — compose + enroll system.yaml host.jobs timers
# ---------------------------------------------------------------------------
phase_host_jobs() {
    log "phase 9/10: host jobs"
    local host_timers_dir="$CLAUDLOBBY_ROOT/runtime/_host/timers"

    # Compose first — host units are package-owned (system.yaml host.jobs) and
    # need no fleet.yaml, so a cold host gets them before any fleet exists.
    # `claudlobby generate` also emits them; this is the same single source.
    # claudlobby_cli (lib-common) owns the console-script → `python3 -m` ladder
    # for the whole repo. It also probes the import from $CLAUDLOBBY_ROOT rather
    # than the caller's cwd, which the inline copy this replaced got wrong, and
    # returns 127 when neither rung resolves.
    if [ "$DRY_RUN" = 1 ] && ! _claudlobby_importable; then
        # `run` returns 0 whether it executed or skipped, so the check below
        # cannot fire under --dry-run. Probe directly instead, or host-jobs goes
        # unreported in BOTH summary columns on a host with no claudlobby.
        miss "claudlobby package not importable — cannot compose host jobs"
        PREREQ_MISSING+=("host-jobs")
        NEXT_STEPS+=("Install claudlobby, then re-run to enroll host job timers")
        return
    fi
    if ! run claudlobby_cli host-timers; then
        miss "claudlobby package not importable — cannot compose host jobs"
        PREREQ_MISSING+=("host-jobs")
        NEXT_STEPS+=("Install the package (phase 4), then re-run lib/setup-system")
        return
    fi

    if [ "$DRY_RUN" = 1 ]; then
        printf 'setup-system: [dry-run] would enroll host job timers from %s\n' "$host_timers_dir"
        return
    fi
    if [ ! -d "$host_timers_dir" ]; then
        log "no host jobs composed at $host_timers_dir — nothing to enroll"
        return
    fi

    # Enroll through the shared enrollment spine (no inline copy logic):
    # TIMER_DIR + UNIT_NAME env overrides point the generic enroller at the
    # host units' fixed claudlobby-<name> identity. Per-job isolation: one
    # failed enrollment never blocks the rest — a re-run converges.
    local enroller ext t base jobname found=0
    if [ "$_OS" = "Linux" ]; then
        if ! command -v systemctl >/dev/null 2>&1; then
            miss "systemctl unavailable — cannot enroll host jobs"
            PREREQ_MISSING+=("host-jobs")
            NEXT_STEPS+=("Re-run lib/setup-system on a host with systemd user services")
            return
        fi
        enroller="$SCRIPT_DIR/install_fleet_timer.sh"
        ext="timer"
    else
        enroller="$SCRIPT_DIR/install_fleet_timer_launchd.sh"
        ext="plist"
    fi
    for t in "$host_timers_dir"/claudlobby-*."$ext"; do
        [ -e "$t" ] || continue
        found=1
        base="$(basename "$t" ".$ext")" # claudlobby-<job>
        jobname="${base#claudlobby-}"
        if TIMER_DIR="$host_timers_dir" UNIT_NAME="$base" "$enroller" "$jobname"; then
            ok "host job enrolled: $base"
            PREREQ_OK+=("host-job-$jobname")
        else
            miss "host job enrollment failed: $base"
            PREREQ_MISSING+=("host-job-$jobname")
            NEXT_STEPS+=("Fix + re-run lib/setup-system to enroll $base (idempotent)")
        fi
    done
    [ "$found" = 1 ] || log "no host job units in $host_timers_dir"
}

# ---------------------------------------------------------------------------
# 10. report — summary matrix + next steps
# ---------------------------------------------------------------------------
phase_report() {
    log "phase 10/10: summary"
    local arch
    arch="$(uname -m)"
    echo
    echo "  host:             $_OS $arch"
    echo "  claudlobby:       $CLAUDLOBBY_ROOT"
    echo "  prereqs ok:       ${PREREQ_OK[*]:-(none)}"
    echo "  prereqs missing:  ${PREREQ_MISSING[*]:-(none)}"
    if [ "${#NEXT_STEPS[@]}" -gt 0 ]; then
        echo
        echo "  next steps:"
        for step in "${NEXT_STEPS[@]}"; do
            echo "    - $step"
        done
    fi
    echo
    if [ "$DRY_RUN" = 1 ]; then
        log "dry-run complete — no changes made"
    else
        log "setup complete"
    fi
}

