#!/bin/bash
# git-credential-github-app — mint a GitHub App installation token on demand.
#
# A git credential helper (App-auth P1, #1271; plan:
# documentation/plans/2026-08-19-github-app-installation-token-auth.md).
# Signs an RS256 App JWT with openssl, exchanges it at api.github.com for a
# ~1-hour ghs_ installation token, and answers git's credential protocol with
#   username=x-access-token
#   password=<ghs_ token>
#
# Credentials come from the environment first (the bot.conf .env tier chain),
# then from a config file for operator/cron contexts:
#   GITHUB_APP_ID                — the App ID (numeric, top of the App page)
#   GITHUB_APP_INSTALLATION_ID   — the installation ID for the org/account
#   GITHUB_APP_PRIVATE_KEY_PATH  — path to the App private-key .pem
#   config fallback: github_app_conf_path (lib-common) — by default
#   ~/.config/claudlobby/github-app.conf (0600, key=value), parsed with
#   parse_env_file, never sourced. CLAUDLOBBY_GITHUB_APP_CONF overrides.
#
# THE PROGRAM INVARIANT (D1/D10): every non-git token acquisition invokes the
# helper directly — never `git credential fill`. A pathless fill cannot match
# an org-scoped credential section, so the fill pattern silently substitutes
# another identity in the happy path. Consumers other than git itself (the
# MCP wrapper, creds-check, skills, the gh shim) should reach it through
# lib/mint-github-token.sh — token on stdout, D9 on failure — rather than
# re-implementing the context pipe and password parse.
#
# FAILURE CONTRACT (D9 + D11): on hard failure this prints `quit=1` on stdout
# — the documented git-credential attribute that stops the helper chain — so
# git fails LOUDLY instead of falling through to the gh fallback with the
# operator identity; plus a reason on stderr, an auth_mint_failed JSONL event,
# and a nonzero exit. A request for a non-GitHub host gets silence at rc 0
# instead: the helper is not authoritative there and the chain must continue.
#
# Dependencies: openssl, curl, jq (opt-in — only App-mode fleets need them;
# F2 locked openssl-CLI signing so there is no pip surface).
set -euo pipefail

ACTION="${1:-}"

usage() {
    printf 'Usage: git-credential-github-app <get|store|erase>\n' >&2
    printf 'Invoked by git as a credential helper, or directly:\n' >&2
    printf '  printf "protocol=https\\nhost=github.com\\n\\n" | %s get\n' "$0" >&2
    exit 2
}

# Dispatch BEFORE sourcing lib-common: git broadcasts `store` to every helper
# in the chain on every successful auth (and `erase` on failures), and the
# composed cache layer shields only `get` — so store/erase are the hot path
# and need nothing below. Measured: dispatch-first 3.7ms vs 14.1ms with the
# source above it (M-series; the gap multiplies on the Pi). The drain uses
# the read builtin so the no-op path forks nothing.
case "$ACTION" in
    store|erase)
        if [ ! -t 0 ]; then
            while IFS= read -r _; do :; done || true
        fi
        exit 0
        ;;
    get) ;;
    *) usage ;;
esac

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-common.sh
. "$LIB_DIR/lib-common.sh"
install_error_trap ""

# Fail loudly: stderr reason + JSONL breadcrumb + quit=1 (stop the helper
# chain, D11) + nonzero exit (D9 for direct invocation).
hard_fail() {
    local stage="$1"; shift
    local reason="$*"
    printf 'git-credential-github-app: %s\n' "$reason" >&2
    local data
    data=$(printf '{"stage":"%s","reason":"%s"}' \
        "$(json_escape "$stage")" "$(json_escape "$reason")")
    emit_fleet_event auth_mint_failed github-app-helper "$data"
    printf 'quit=1\n'
    exit 1
}

# --- read the credential context git pipes in --------------------------------
# Consume until the blank line. Only `host` steers behavior: for a non-GitHub
# host this helper is mis-wired and must stay silent (rc 0, no quit) so the
# rest of the chain still serves that host.
CTX_HOST=""
if [ ! -t 0 ]; then
    while IFS= read -r line; do
        [ -z "$line" ] && break
        case "$line" in
            host=*) CTX_HOST="${line#host=}" ;;
        esac
    done
fi
if [ -n "$CTX_HOST" ] && [ "$CTX_HOST" != "github.com" ]; then
    exit 0
fi

# --- resolve App credentials: env first, config file as fallback -------------
_env_app_id="${GITHUB_APP_ID:-}"
_env_inst_id="${GITHUB_APP_INSTALLATION_ID:-}"
_env_key_path="${GITHUB_APP_PRIVATE_KEY_PATH:-}"

CONF="$(github_app_conf_path)"
if { [ -z "$_env_app_id" ] || [ -z "$_env_inst_id" ] || [ -z "$_env_key_path" ]; } \
        && [ -r "$CONF" ]; then
    # parse_env_file, never `.`: the house .env parser strips quotes and
    # REJECTS command substitution — a credential helper must not execute
    # whatever lands in a config file.
    parse_env_file "$CONF"
fi
# Env wins per var over whatever the config file assigned.
[ -n "$_env_app_id" ]   && GITHUB_APP_ID="$_env_app_id"
[ -n "$_env_inst_id" ]  && GITHUB_APP_INSTALLATION_ID="$_env_inst_id"
[ -n "$_env_key_path" ] && GITHUB_APP_PRIVATE_KEY_PATH="$_env_key_path"

if [ -z "${GITHUB_APP_ID:-}" ] || [ -z "${GITHUB_APP_INSTALLATION_ID:-}" ] \
        || [ -z "${GITHUB_APP_PRIVATE_KEY_PATH:-}" ]; then
    hard_fail config "GITHUB_APP_ID / GITHUB_APP_INSTALLATION_ID / GITHUB_APP_PRIVATE_KEY_PATH not set (env or $CONF) — run lib/setup-github-app.sh to validate and write them"
fi

for dep in openssl curl jq; do
    command -v "$dep" > /dev/null 2>&1 \
        || hard_fail deps "required tool missing: $dep (App-mode fleets need openssl, curl, jq)"
done

[ -r "$GITHUB_APP_PRIVATE_KEY_PATH" ] \
    || hard_fail key "cannot read private key at $GITHUB_APP_PRIVATE_KEY_PATH"

# --- sign the App JWT --------------------------------------------------------
# iat is backdated 60s (GitHub guidance; D12 first defense for the RTC-less
# Pi boot-clock window); exp is +540s, well under the 600s cap.
b64url() {
    openssl base64 -A | tr '+/' '-_' | tr -d '='
}

now=$(date +%s)
header='{"alg":"RS256","typ":"JWT"}'
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' \
    $((now - 60)) $((now + 540)) "$GITHUB_APP_ID")

signing_input="$(printf '%s' "$header" | b64url).$(printf '%s' "$payload" | b64url)"
if ! sig="$(printf '%s' "$signing_input" \
        | openssl dgst -sha256 -sign "$GITHUB_APP_PRIVATE_KEY_PATH" -binary 2> /dev/null \
        | b64url)" || [ -z "$sig" ]; then
    hard_fail key "openssl could not sign with $GITHUB_APP_PRIVATE_KEY_PATH (not an RSA private key, or CRLF-corrupted — run: openssl rsa -in <key> -check -noout)"
fi
app_jwt="$signing_input.$sig"

# --- exchange the JWT for an installation token ------------------------------
# The JWT rides a curl config file via auth_curl_cfg (lib-common), never argv.
auth_cfg="$(auth_curl_cfg \
    "Authorization: Bearer $app_jwt" \
    "Accept: application/vnd.github+json" \
    "X-GitHub-Api-Version: 2022-11-28")"
body_f="$(safe_mktemp)"
err_f="$(safe_mktemp)"

code="$(curl -sS -X POST --max-time 15 --config "$auth_cfg" \
    -o "$body_f" -w '%{http_code}' \
    "https://api.github.com/app/installations/${GITHUB_APP_INSTALLATION_ID}/access_tokens" \
    2> "$err_f")" || code="curl_err($(head -c 120 "$err_f"))"

case "$code" in
    200|201) ;;
    401)
        hard_fail exchange "GitHub 401 on the JWT exchange: $(head -c 160 "$body_f") — wrong key for App ID ${GITHUB_APP_ID}, a revoked key, or clock skew; lib/setup-github-app.sh diagnoses all three"
        ;;
    *)
        hard_fail exchange "token exchange failed (HTTP $code): $(head -c 160 "$body_f")"
        ;;
esac

token="$(jq -r '.token // empty' < "$body_f" 2> /dev/null)" || token=""
[ -n "$token" ] || hard_fail exchange "exchange returned HTTP $code but no .token field"

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
