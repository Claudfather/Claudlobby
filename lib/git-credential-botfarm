#!/bin/bash
# git-credential-botfarm — mint a fresh GitHub App installation token on demand
# Reads config from ~/.config/botfarm/config (key=value format).
# Env vars override config file values:
#   BOTFARM_APP_ID            — GitHub App ID (e.g., 1234567)
#   BOTFARM_INSTALLATION_ID   — Installation ID (e.g., 7654321)
#   BOTFARM_PRIVATE_KEY_PATH  — Path to private-key.pem
#   BOTFARM_CONFIG            — Override config file path (default: ~/.config/botfarm/config)
set -euo pipefail

[ "${1:-}" = "get" ] || exit 0

CONFIG_FILE="${BOTFARM_CONFIG:-$HOME/.config/botfarm/config}"
if [[ -r "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

: "${BOTFARM_APP_ID:?must be set in $CONFIG_FILE or environment}"
: "${BOTFARM_INSTALLATION_ID:?must be set in $CONFIG_FILE or environment}"
: "${BOTFARM_PRIVATE_KEY_PATH:?must be set in $CONFIG_FILE or environment}"

if [[ ! -r "$BOTFARM_PRIVATE_KEY_PATH" ]]; then
  echo "Error: cannot read private key at $BOTFARM_PRIVATE_KEY_PATH" >&2
  exit 1
fi

token=$(BOTFARM_APP_ID="$BOTFARM_APP_ID" \
        BOTFARM_INSTALLATION_ID="$BOTFARM_INSTALLATION_ID" \
        BOTFARM_PRIVATE_KEY_PATH="$BOTFARM_PRIVATE_KEY_PATH" \
        python3 - <<'PY'
import json, os, sys, time, urllib.request
try:
    import jwt
    import cryptography  # noqa: F401 — required by PyJWT for RS256 signing
except ImportError as e:
    print(f"git-credential-botfarm: missing dependency ({e.name}).", file=sys.stderr)
    print("Run: uv pip install pyjwt cryptography --break-system-packages --system", file=sys.stderr)
    sys.exit(1)

app_id          = os.environ["BOTFARM_APP_ID"]
installation_id = os.environ["BOTFARM_INSTALLATION_ID"]
key_path        = os.environ["BOTFARM_PRIVATE_KEY_PATH"]

with open(key_path) as f:
    pem = f.read()

now = int(time.time())
app_jwt = jwt.encode(
    {"iat": now - 60, "exp": now + 540, "iss": app_id},
    pem,
    algorithm="RS256",
)

req = urllib.request.Request(
    f"https://api.github.com/app/installations/{installation_id}/access_tokens",
    method="POST",
    headers={
        "Authorization": f"Bearer {app_jwt}",
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
    },
)

try:
    with urllib.request.urlopen(req, timeout=15) as r:
        data = json.loads(r.read())
        print(data["token"])
except urllib.error.HTTPError as e:
    print(f"GitHub returned {e.code}: {e.read().decode()}", file=sys.stderr)
    sys.exit(1)
PY
)

if [[ -z "$token" ]]; then
  echo "Error: failed to mint installation token" >&2
  exit 1
fi

echo "username=x-access-token"
echo "password=$token"
