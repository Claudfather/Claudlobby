{
  "_env_contract": {
    "PRINTIFY_API_KEY": {
      "description": "Printify Personal Access Token",
      "default_tier": "fleet",
      "secret": true
    },
    "PRINTIFY_SHOP_ID": {
      "description": "Printify shop ID",
      "default_tier": "fleet",
      "secret": false
    }
  },
  "_permissions_contract": {
    "tools": [
      "create_product",
      "delete_product",
      "generate_and_upload_image",
      "generate_image",
      "get_blueprint",
      "get_blueprints",
      "get_defaults",
      "get_print_providers",
      "get_printify_status",
      "get_product",
      "get_variants",
      "how_to_use",
      "list_products",
      "list_shops",
      "publish_product",
      "set_default",
      "switch_shop",
      "update_product",
      "upload_image"
    ],
    "read_only_tools": [
      "get_blueprint",
      "get_blueprints",
      "get_defaults",
      "get_print_providers",
      "get_printify_status",
      "get_product",
      "get_variants",
      "how_to_use",
      "list_products",
      "list_shops"
    ]
  },
  "_note": "DRAFT — do NOT merge until the fixed fork is published to npm. The previous default ran the UPSTREAM 'printify-mcp' package, which fabricates 'Mock Shop 1' on a transient init failure and still reports Connected: Yes (fixed in chrisrogers37/printify-mcp PR #1 + #2). This points at the fixed fork instead. BLOCKER: @chrisrogers37/printify-mcp is not yet on npm; until it is, fleets should override this fragment locally to point command:'node' at a built fork (dist/index.js).",
  "printify": {
    "command": "npx",
    "args": ["-y", "@chrisrogers37/printify-mcp@latest"],
    "env": {
      "PRINTIFY_API_KEY": "${PRINTIFY_API_KEY}",
      "PRINTIFY_SHOP_ID": "${PRINTIFY_SHOP_ID}"
    }
  }
}
