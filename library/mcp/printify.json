{
  "_env_contract": {
    "PRINTIFY_API_KEY": {
      "description": "Printify Personal Access Token",
      "tier": "fleet"
    },
    "PRINTIFY_SHOP_ID": {
      "description": "Printify shop ID",
      "tier": "fleet"
    }
  },
  "_permissions_contract": {
    "tools": [
      "create_product",
      "delete_product",
      "generate_and_upload_image",
      "generate_image",
      "get_blueprint",
      "get_blueprints",
      "get_defaults",
      "get_print_providers",
      "get_printify_status",
      "get_product",
      "get_variants",
      "how_to_use",
      "list_products",
      "list_shops",
      "publish_product",
      "set_default",
      "switch_shop",
      "update_product",
      "upload_image"
    ],
    "read_only_tools": [
      "get_blueprint",
      "get_blueprints",
      "get_defaults",
      "get_print_providers",
      "get_printify_status",
      "get_product",
      "get_variants",
      "how_to_use",
      "list_products",
      "list_shops"
    ]
  },
  "printify": {
    "command": "npx",
    "args": ["-y", "printify-mcp"],
    "env": {
      "PRINTIFY_API_KEY": "${PRINTIFY_API_KEY}",
      "PRINTIFY_SHOP_ID": "${PRINTIFY_SHOP_ID}"
    }
  }
}
