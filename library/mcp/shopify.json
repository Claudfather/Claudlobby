{
  "_env_contract": {
    "SHOPIFY_ACCESS_TOKEN": {
      "description": "Shopify Admin API access token",
      "tier": "fleet",
      "secret": true
    },
    "SHOPIFY_STORE_DOMAIN": {
      "description": "Shopify store domain (e.g. mystore.myshopify.com)",
      "tier": "fleet",
      "secret": false
    }
  },
  "_permissions_contract": {
    "tools": [
      "adjustInventory",
      "createArticle",
      "createCompany",
      "createDiscountCode",
      "createDraftOrder",
      "createFulfillment",
      "createGiftCard",
      "createMetaobject",
      "createPage",
      "createProduct",
      "createRedirect",
      "createRefund",
      "createWebhook",
      "getAbandonmentReport",
      "getConversionReport",
      "getCustomReport",
      "getCustomer",
      "getCustomerAnalytics",
      "getFinancialSummary",
      "getInventoryLevels",
      "getInventoryReport",
      "getMarketingReport",
      "getOrder",
      "getProduct",
      "getProductAnalytics",
      "getSalesReport",
      "getShippingZones",
      "getShopInfo",
      "getTrafficReport",
      "listAbandonedCheckouts",
      "listBlogs",
      "listCollections",
      "listCompanies",
      "listCustomers",
      "listDiscounts",
      "listDraftOrders",
      "listFulfillmentOrders",
      "listGiftCards",
      "listLocations",
      "listMarkets",
      "listMetaobjects",
      "listOrders",
      "listPages",
      "listPriceRules",
      "listProducts",
      "listThemes",
      "listTransactions",
      "listWebhooks",
      "setMetafield",
      "updateProduct"
    ],
    "read_only_tools": [
      "getAbandonmentReport",
      "getConversionReport",
      "getCustomReport",
      "getCustomer",
      "getCustomerAnalytics",
      "getFinancialSummary",
      "getInventoryLevels",
      "getInventoryReport",
      "getMarketingReport",
      "getOrder",
      "getProduct",
      "getProductAnalytics",
      "getSalesReport",
      "getShippingZones",
      "getShopInfo",
      "getTrafficReport",
      "listAbandonedCheckouts",
      "listBlogs",
      "listCollections",
      "listCompanies",
      "listCustomers",
      "listDiscounts",
      "listDraftOrders",
      "listFulfillmentOrders",
      "listGiftCards",
      "listLocations",
      "listMarkets",
      "listMetaobjects",
      "listOrders",
      "listPages",
      "listPriceRules",
      "listProducts",
      "listThemes",
      "listTransactions",
      "listWebhooks"
    ]
  },
  "shopify": {
    "command": "npx",
    "args": ["-y", "@ajackus/shopify-mcp-server@1.1.0"],
    "env": {
      "SHOPIFY_ACCESS_TOKEN": "${SHOPIFY_ACCESS_TOKEN}",
      "SHOPIFY_STORE_DOMAIN": "${SHOPIFY_STORE_DOMAIN}"
    }
  }
}
