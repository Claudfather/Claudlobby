{
  "_env_contract": {
    "HA_URL": {
      "description": "Home Assistant base URL",
      "tier": "fleet",
      "secret": false
    },
    "HA_TOKEN": {
      "description": "Home Assistant long-lived access token",
      "tier": "fleet",
      "secret": true
    }
  },
  "_permissions_contract": {
    "tools": [
      "call_service_tool",
      "domain_summary_tool",
      "entity_action",
      "get_entity",
      "get_error_log",
      "get_history",
      "get_version",
      "list_automations",
      "list_entities",
      "restart_ha",
      "search_entities_tool",
      "system_overview"
    ]
  },
  "homeassistant": {
    "type": "http",
    "url": "${HA_URL}/api/mcp/",
    "headers": {
      "Authorization": "Bearer ${HA_TOKEN}"
    }
  }
}
