{
  "_env_contract": {
    "SPOTIFY_CLIENT_ID": {
      "description": "Spotify OAuth client ID",
      "default_tier": "fleet",
      "secret": true
    },
    "SPOTIFY_CLIENT_SECRET": {
      "description": "Spotify OAuth client secret",
      "default_tier": "fleet",
      "secret": true
    }
  },
  "_permissions_contract": {
    "tools": [
      "SpotifyGetInfo",
      "SpotifyPlayback",
      "SpotifyPlaylist",
      "SpotifyQueue",
      "SpotifySearch"
    ]
  },
  "spotify": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-spotify"],
    "env": {
      "SPOTIFY_CLIENT_ID": "${SPOTIFY_CLIENT_ID}",
      "SPOTIFY_CLIENT_SECRET": "${SPOTIFY_CLIENT_SECRET}"
    }
  }
}
