{
  "_env_contract": {
    "GOOGLE_OAUTH_CLIENT_ID": {
      "description": "Google OAuth client ID",
      "tier": "fleet"
    },
    "GOOGLE_OAUTH_CLIENT_SECRET": {
      "description": "Google OAuth client secret",
      "tier": "fleet"
    },
    "WORKSPACE_MCP_PORT": {
      "description": "Port for Gmail/Calendar MCP server",
      "tier": "fleet"
    },
    "WORKSPACE_MCP_BASE_URI": {
      "description": "Base URI for workspace MCP server",
      "tier": "fleet"
    }
  },
  "_permissions_contract": {
    "tools": [],
    "_note": "Deprecated — use gws.json with a single instance instead"
  },
  "gmail": {
    "command": "uvx",
    "args": ["workspace-mcp", "--single-user", "--tools", "gmail", "calendar"],
    "env": {
      "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
      "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
      "WORKSPACE_MCP_PORT": "${WORKSPACE_MCP_PORT}",
      "WORKSPACE_MCP_BASE_URI": "${WORKSPACE_MCP_BASE_URI}"
    }
  }
}
