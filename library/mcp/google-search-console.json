{
  "_env_contract": {
    "GSC_SA_KEY_PATH": {
      "description": "Absolute path to the Google service-account JSON key granted access to the Search Console property (gitignored — NEVER commit the key; e.g. local/<fleet>/.secrets/gsc-service-account.json). To reuse the google-analytics service account, point this at the SAME key file as GA4_SA_KEY_PATH and add that SA's client_email as a user on the GSC property (GSC authorizes per-property and does not inherit GA4 access).",
      "tier": "fleet",
      "secret": true
    }
  },
  "_permissions_contract": {
    "tools": [
      "list_properties",
      "get_site_details",
      "get_search_analytics",
      "get_advanced_search_analytics",
      "get_performance_overview",
      "compare_search_periods",
      "get_search_by_page_query",
      "get_sitemaps",
      "list_sitemaps_enhanced",
      "get_sitemap_details",
      "inspect_url_enhanced",
      "batch_url_inspection",
      "check_indexing_issues",
      "get_creator_info",
      "get_capabilities",
      "reauthenticate",
      "add_site",
      "delete_site",
      "submit_sitemap",
      "delete_sitemap",
      "manage_sitemaps"
    ],
    "read_only_tools": [
      "list_properties",
      "get_site_details",
      "get_search_analytics",
      "get_advanced_search_analytics",
      "get_performance_overview",
      "compare_search_periods",
      "get_search_by_page_query",
      "get_sitemaps",
      "list_sitemaps_enhanced",
      "get_sitemap_details",
      "inspect_url_enhanced",
      "batch_url_inspection",
      "check_indexing_issues",
      "get_creator_info",
      "get_capabilities"
    ]
  },
  "google-search-console": {
    "command": "uvx",
    "args": ["--from", "mcp-search-console==0.3.2", "mcp-search-console"],
    "env": {
      "GSC_CREDENTIALS_PATH": "${GSC_SA_KEY_PATH}",
      "GSC_SKIP_OAUTH": "true",
      "GSC_ALLOW_DESTRUCTIVE": "false"
    }
  }
}
